{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Terminal Agent",
  "version": "0.2.0",
  "identifier": "com.enavilo.app.ota",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Terminal Agent",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: https://asset.localhost; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1MkNBQzE5RDI2MTI5MzQKUldRMEtXSFNHYXdzaFoycmYrbGtpTksyNFJTUnRBems5R3RxcTJuakNNMER3NDhKbWhYOFNJamgK",
      "endpoints": [
        "https://github.com/yujieco/open-terminal-agent/releases/latest/download/latest.json"
      ]
    }
  }
}
